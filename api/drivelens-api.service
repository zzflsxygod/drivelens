[Unit]
Description=DriveLens API (TeslaMate data viewer)
After=network-online.target docker.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/drivelens-api.env
ExecStart=/usr/local/bin/drivelens-api
Restart=on-failure
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
